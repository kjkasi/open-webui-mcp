# Open WebUI connection
OPENWEBUI_BASE_URL=http://127.0.0.1:3000
OPENWEBUI_API_KEY=replace-with-an-open-webui-api-key
# Optional default knowledge base. Required unless every call supplies an ID.
OPENWEBUI_KNOWLEDGE_ID=
# Comma-separated allowlist. When set, no other knowledge ID can be queried.
OPENWEBUI_ALLOWED_KNOWLEDGE_IDS=
OPENWEBUI_TIMEOUT_SECONDS=20
OPENWEBUI_MAX_RETRIES=2

# MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Optional. When set, HTTP clients must send Authorization: Bearer <token>.
MCP_AUTH_TOKEN=
LOG_LEVEL=INFO
